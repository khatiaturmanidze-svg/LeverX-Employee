{
  "extends": "../../tsconfig.common.json",
  "include": ["src", "setUpTests.ts", "**/*.test.ts", "**/*.test.tsx"],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "jsx": "react-jsx",

    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@pages/*": ["./src/pages/*"],
      "@features/*": ["./src/features/*"],
      "@shared/*": ["./src/shared/*"],
      "@types/*": ["./src/types/*"]
    },
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"]
  }
}
