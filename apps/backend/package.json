{
  "name": "@mono/backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "nodemon dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.js",
    "db:generate": "prisma generate",
