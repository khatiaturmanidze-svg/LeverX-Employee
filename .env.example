# network
VITE_API_PORT = 3000
VITE_API_TARGET=http://localhost:3000

# security
SESSION_SECRET=replace-with-a-stable-random-secret-generated-from-32-random-bytes
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Local development permits self-registration. Production defaults to false.
# Enable only if public Employee-role signup is an intentional product policy.
# ALLOW_PUBLIC_SIGNUP=false
# Leave unset for direct connections. Configure only verified trusted proxy IPs,
# subnets, or a verified hop count; never use true.
# TRUST_PROXY=127.0.0.1/32
BCRYPT_SALT_ROUNDS=13
SYNTHETIC_LATENCY_MIN=50
SYNTHETIC_LATENCY_MAX=5000

# PostgreSQL used by normal application startup
DATABASE_URL=postgresql://username:password@localhost:5432/leverx_employee

# Optional manual JSON snapshot import; not used by the running app
DATABASE_PATH=./src/db.json

# Development admin, created only by the explicit seedAdmin command
SEED_ADMIN_EMAIL=alex.taylor@example.com
SEED_ADMIN_PASSWORD=password11


# Optional integration tests; use a dedicated database ending in _test
# For npm run test:integration, copy .env.test.example to .env.test instead.
# TEST_DATABASE_URL=postgresql://username:password@localhost:5432/leverx_employee_test
