# network
VITE_API_PORT = 3000
VITE_API_TARGET=http://localhost:3000

# security
VITE_AUTH_TOKEN=authorized-can-access
BCRYPT_SALT_ROUNDS=13
SYNTHETIC_LATENCY_MIN=50
SYNTHETIC_LATENCY_MAX=5000

# PostgreSQL used by normal application startup
DATABASE_URL=postgresql://username:password@localhost:5432/leverx_employee

# Optional manual JSON snapshot import; not used by the running app
DATABASE_PATH=./src/db.json

# Development admin, created only by the explicit seedAdmin command
VITE_TEST_USER_EMAIL=alex.taylor@example.com
VITE_TEST_USER_PASSWORD=password11


# Optional integration tests; use a dedicated database ending in _test
# TEST_DATABASE_URL=postgresql://username:password@localhost:5432/leverx_employee_test
